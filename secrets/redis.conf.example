# Copy to secrets/redis.conf (gitignored) and replace the password, or let
# scripts/setup.sh generate it. Use letters and digits only: the same value
# goes into REDIS_URL (redis://:<password>@redis:6379) in .env.
#   printf 'requirepass %s\n' "$(openssl rand -hex 32)" > secrets/redis.conf
requirepass change-me-to-a-long-random-hex-string
