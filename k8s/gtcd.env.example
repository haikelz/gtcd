# Copy this file to k8s/gtcd.env, fill in real values, then `kubectl apply -k k8s/`.
# k8s/gtcd.env is gitignored; never commit real credentials.

# Base URL of your GoatCounter instance as reachable from inside the cluster.
GOATCOUNTER_URL=http://goatcounter:8080

# GoatCounter API token with read permissions.
GOATCOUNTER_API_KEY=<GOATCOUNTER_API_KEY>

# Redis connection; optional, the app falls back to in-memory sessions.
REDIS_URL=redis://redis:6379
