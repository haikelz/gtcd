# Copy to k8s/.env, fill in real values, then run k8s/deploy-k8s.sh.
# k8s/.env is gitignored; never commit real credentials.

# Public domain of the dashboard (Ingress host + TLS).
DOMAIN=analytics.example.com

# Email for the Let's Encrypt ClusterIssuer (shared/clusterissuer.yaml).
EMAIL=admin@example.com

# gtcd image. CI (.github/workflows/deploy.yaml) publishes
# <DOCKER_USERNAME>/gtcd:sha-<commit> for amd64 and arm64; deploy that
# immutable tag or its digest rather than :latest:
#   docker buildx imagetools inspect docker.io/you/gtcd:sha-abc1234   # -> digest
IMAGE=docker.io/you/gtcd:sha-abc1234

# In-cluster GoatCounter (deployed from gtcd/goatcounter.yaml).
# Use https://your-external-gc-host instead if GoatCounter runs elsewhere.
GOATCOUNTER_URL=http://goatcounter:8080

# GoatCounter API token. The full deployment helper requires a nonempty token.
# For a new in-cluster instance, select the intended kubeconfig/namespace and
# apply only GoatCounter first (requires a default StorageClass):
#   kubectl apply -f k8s/gtcd/goatcounter.yaml
#   kubectl rollout status deployment goatcounter --timeout=180s
# Then bootstrap the site/token below and save the token here before running
# deploy-k8s.sh. Use the real configured domain, email and a securely supplied
# password; do not save secrets in command history or shared logs.
#   kubectl exec deploy/goatcounter -- goatcounter db create site \
#     -vhost $DOMAIN -user.email you@example.com -user.password '...' -createdb
#   kubectl exec deploy/goatcounter -- goatcounter db create apitoken \
#     -name gtcd-dashboard -user 1 -perm "count,export,site_read,site_create,site_update"
#   kubectl exec deploy/goatcounter -- goatcounter db query \
#     "UPDATE api_tokens SET permissions='127' WHERE name='gtcd-dashboard'" -format exec
GOATCOUNTER_API_KEY=

# Password for Redis (sessions, cache and durable application state). See
# docs/REDIS_STATE.md before replacing an existing ephemeral installation.
# deploy-k8s.sh puts
# it into the redis-config Secret as requirepass and into gtcd's REDIS_URL.
# Letters and digits only, 16+ characters:
#   openssl rand -hex 32
REDIS_PASSWORD=

# Optional: comma-separated GoatCounter accounts allowed to manage sites and
# exports in gtcd. Leave blank to disable gtcd's admin tools.
GTCD_ADMIN_EMAILS=

# Optional: public HTTPS GoatCounter management URL for password reset and
# native secret-site links. GTCD administration uses a server-side session bridge.
# Plain HTTP is accepted only for localhost development.
GOATCOUNTER_ADMIN_URL=

# Optional: email reports over SMTP. Reports are off until SMTP_HOST and
# SMTP_FROM are set. SMTP_SECURE=true uses implicit TLS (usually port 465);
# otherwise STARTTLS is negotiated when the server offers it (port 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="gtcd reports <reports@example.com>"
# Public dashboard URL used for links inside emails, e.g. https://analytics.example.com
GTCD_PUBLIC_URL=

# Optional: Cloudflare Turnstile bot check on the login form. The check is off
# until both keys are set (Cloudflare dashboard > Turnstile > Add widget).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: client IP header for the per-IP login rate limit (the per-email
# limit always applies). Leave empty to skip the per-IP limit. Behind
# Cloudflare use cf-connecting-ip; behind only Traefik use x-forwarded-for.
ADDRESS_HEADER=
XFF_DEPTH=1
