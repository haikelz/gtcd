localhost {
	# GoatCounter tracking endpoint and its script, served by this instance
	@tracking path /count /count.js
	handle @tracking {
		reverse_proxy goatcounter:8080
	}

	# GoatCounter public visitor counter (only answers when enabled per site)
	handle /counter/* {
		reverse_proxy goatcounter:8080
	}

	handle /admin/* {
		reverse_proxy goatcounter:8080
	}

	handle {
		reverse_proxy gtcd:3000
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	encode gzip zstd
}
