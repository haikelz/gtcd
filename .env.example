# Custom domain for your dashboard (e.g., analytics.example.com)
# Leave as localhost for local development
DOMAIN=localhost

GOATCOUNTER_URL=http://goatcounter:8080
GOATCOUNTER_API_KEY=
# Comma-separated GoatCounter accounts allowed to manage sites and exports in gtcd.
GTCD_ADMIN_EMAILS=
# Public HTTPS GoatCounter URL for password-reset and native secret-site links.
# GTCD administration renders allowlisted forms using a server-held personal session.
# Plain HTTP is accepted only for localhost development.
GOATCOUNTER_ADMIN_URL=
# Password must match requirepass in secrets/redis.conf (scripts/setup.sh writes both).
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379

# Optional: email reports over SMTP. Reports are off until SMTP_HOST and
# SMTP_FROM are set. SMTP_SECURE=true uses implicit TLS (usually port 465);
# otherwise STARTTLS is negotiated when the server offers it (port 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="gtcd reports <reports@example.com>"
# Public dashboard URL used for links inside emails, e.g. https://analytics.example.com
GTCD_PUBLIC_URL=

# Optional: Cloudflare Turnstile bot check on the login form. The check is off
# until both keys are set (Cloudflare dashboard > Turnstile > Add widget).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: client IP header for the per-IP login rate limit. Compose defaults
# to x-forwarded-for from Caddy; behind Cloudflare use cf-connecting-ip.
ADDRESS_HEADER=
XFF_DEPTH=1
